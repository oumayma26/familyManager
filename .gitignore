# ============================
# PYTHON
# ============================

# Environnement virtuel
venv/
env/
ENV/
.venv/

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / build
build/
dist/
*.egg-info/
.eggs/
*.egg

# ============================
# PYINSTALLER
# ============================

# Fichiers générés par PyInstaller
*.spec
!family_manager.spec    # Garde le .spec si tu veux le versionner

# ============================
# BASE DE DONNEES
# ============================

# Base de données locale (ne pas versionner)
*.db
*.sqlite
*.sqlite3

# Dossier des backups (trop lourd)
backups/

# ============================
# IDE / EDITORS
# ============================

# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# ============================
# OS
# ============================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ============================
# LOGS & TEMP
# ============================

*.log
*.tmp
*.temp
*.bak
*.swp
*~

# ============================
# SECRETS (ne jamais versionner !)
# ============================

.env
.env.local
*.pem
*.key
